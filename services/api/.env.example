# FarmSignal API — copy to .env and adjust. All keys map to app/config.py Settings.
APP_NAME=FarmSignal API
ENV=dev                                   # dev | test | prod
DATABASE_URL=sqlite:///./farmsignal.db    # prod: postgresql+psycopg://user:pass@host:5432/farmsignal
JWT_SECRET=change-me-in-prod-use-at-least-32-random-bytes
JWT_TTL_DAYS=30

# Agmarknet via data.gov.in (default = public sample key, rate-limited)
AGMARKNET_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_TIMEOUT_S=5
PRICE_POLL_HOURS=6
PRICE_STALE_HOURS=30

PUBLIC_BASE_URL=http://localhost:5173     # used in Quality Pass QR links
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=60

# Routing constants (contract section 3)
ROAD_FACTOR=1.3
AVG_SPEED_KMH=35
SAFETY_FACTOR=0.8
TRANSPORT_COST_PER_KM_INR=12

DEMO_MODE=true
# DATA_DIR defaults to <repo>/data; override only when the data folder lives elsewhere (Docker).
# DATA_DIR=/data
